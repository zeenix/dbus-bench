diff --git a/src/bin/busd.rs b/src/bin/busd.rs
index 4239a11..b4805e2 100644
--- a/src/bin/busd.rs
+++ b/src/bin/busd.rs
@@ -59,6 +59,18 @@ fn main() -> Result<()> {
 
 async fn run() -> Result<()> {
     busd::tracing_subscriber::init();
+    // Held for as long as `run` runs: the thread's own runtime goes once nothing holds it.
+    let _busy_poll = match std::env::var("ZRUNTIME_BUSY_POLL_US")
+        .ok()
+        .and_then(|v| v.parse().ok())
+    {
+        Some(us) => {
+            let runtime = SharedRuntime::current()?;
+            runtime.set_busy_poll(std::time::Duration::from_micros(us));
+            Some(runtime)
+        }
+        None => None,
+    };
 
     let args = Args::parse();
 
