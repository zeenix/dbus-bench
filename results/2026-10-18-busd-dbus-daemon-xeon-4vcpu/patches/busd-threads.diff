+    /// The number of worker threads that `BUSD_THREADS` asks for: none if it is unset, empty or 0.
+    fn worker_count() -> Result<usize> {
+        let threads = env::var("BUSD_THREADS").unwrap_or_default();
+        let threads = threads.trim();
+        if threads.is_empty() {
+            return Ok(0);
+        }
+
+        threads
+            .parse()
+            .with_context(|| format!("invalid BUSD_THREADS `{threads}`"))
+    }
+
+    /// Start `count` threads, each of which drives a runtime of its own for good, and return those
+    /// runtimes.
+    ///
+    /// A runtime is made by `block_on` on the thread that drives it, and `SharedRuntime::current`
+    /// inside it gives that one. Whatever a task of such a runtime builds then lands on it too:
+    /// the free `spawn`, and zbus's connections, which resolve their runtime the same way.
+    fn start_workers(count: usize) -> Result<Vec<SharedRuntime>> {
+        let (sender, receiver) = mpsc::channel();
+        for i in 0..count {
+            let sender = sender.clone();
+            thread::Builder::new()
+                .name(format!("busd worker {i}"))
+                .spawn(move || {
+                    zruntime::block_on(async move {
+                        let _ = sender.send((i, SharedRuntime::current()));
+                        pending::<()>().await
+                    })
+                })
+                .context("failed to start a worker thread")?;
+        }
+        drop(sender);
+
+        // Blocks the thread for the time that the workers take to start, but waits for no work of
+        // the runtime this thread is in, so it cannot deadlock.
+        let mut workers = Vec::with_capacity(count);
+        for _ in 0..count {
+            let (i, runtime) = receiver
+                .recv()
+                .context("a worker thread stopped before it gave its runtime")?;
+            workers.push((i, runtime?));
+        }
+        workers.sort_by_key(|(i, _)| *i);
+
+        Ok(workers.into_iter().map(|(_, runtime)| runtime).collect())
+    }
